{
  "name": "avenirs-cofolio-backoffice-client",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "build-only": "vite build",
    "build-only:development": "vite build -m development",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:development": "run-p type-check \"build-only:development {@}\" --",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:development": "vite preview -m development",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --pool.threads.maxThreads=6 --coverage",
    "test:coverage:shard": "vitest run --reporter=verbose --reporter=blob --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=json --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0",
    "test:unit": "vitest run --pool.threads.maxThreads=6",
    "test:a11y": "run-s -c test:a11y:run test:a11y:cleanup",
    "test:a11y:run": "playwright test --config=a11y/playwright.a11y.config.ts",
    "test:a11y:cleanup": "rimraf a11y/.output",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build --force",
    "prepare": "husky || true && npm run generate:api",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "generate:api": "orval",
    "postgenerate:api": "eslint ./src/api --fix",
    "generate:feature": "node scripts/generate-feature.mjs"
  },
  "dependencies": {
    "@avenirs-esr/avenirs-dsav": "^0.1.357",
    "@tanstack/vue-form": "^1.15.1",
    "@tanstack/vue-query": "^5.74.9",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^13.7.0",
    "@vueuse/router": "^14.1.0",
    "date-fns": "^4.1.0",
    "docx": "^9.7.2",
    "dompurify": "^3.4.17",
    "driver.js": "^1.8.0",
    "focus-trap": "^7.5.4",
    "focus-trap-vue": "^4.0.3",
    "html-to-image": "^1.11.13",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.3.0",
    "vue": "^3.5.44",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "1.56.1",
    "@rushstack/eslint-patch": "^1.10.5",
    "@tsconfig/node26": "^26.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.1.5",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "axe-html-reporter": "^2.2.11",
    "blob-polyfill": "^9.0.20240710",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.2.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "msw": "^2.10.5",
    "npm-run-all2": "^6.2.6",
    "orval": "^8.22.0",
    "rimraf": "^5.0.10",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^0.18.6",
    "vite": "^6.4.4",
    "vite-plugin-vue-devtools": "^7.3.9",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.10",
    "workbox-window": "^7.1.0"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "msw@2.10.2": true,
    "unrs-resolver@1.7.2": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true
  }
}
